{
  "name": "weir",
  "version": "0.1.0",
  "description": "Watch bitcoin addresses, get signed webhooks. Runs on a pruned node — no txindex, no address index.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bech32": "^2.0.0",
    "bitcoinjs-lib": "^6.1.6",
    "bs58check": "^3.0.1",
    "redis": "^4.7.0",
    "zeromq": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
