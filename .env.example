# --- required ---------------------------------------------------------------

# mainnet | testnet | signet | regtest
NETWORK=regtest

# Bitcoin Core RPC. Credentials go in the URL.
BITCOIN_RPC_URL=http://weir:weir@bitcoind:18443

# Bitcoin Core ZMQ endpoint (zmqpubrawtx + zmqpubrawblock, same port is fine)
BITCOIN_ZMQ_URL=tcp://bitcoind:28332

REDIS_URL=redis://redis:6379

# Where events get POSTed
WEBHOOK_URL=http://host.docker.internal:9090/webhook

# HMAC key for webhook signatures. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-openssl-rand-hex-32

# --- optional ----------------------------------------------------------------

# Which confirmation depths fire events. 0 = mempool "seen" events.
# Max value defines the tracking window and reorg-protection depth.
CONFIRMATION_MILESTONES=0,1,3

# Default watch lifetime in seconds. 0 = watch forever.
WATCH_DEFAULT_TTL=0

# Proof-of-life event interval in seconds. 0 = off.
HEARTBEAT_INTERVAL=0

# Setting this enables the HTTP admin API (and is its bearer token).
# Unset = no HTTP server exists, the daemon listens on nothing.
ADMIN_TOKEN=
ADMIN_PORT=8787

# --- advanced tuning (defaults are fine) --------------------------------------
# Per-attempt webhook timeout. Failed deliveries are retried by the outbox with backoff.
WEBHOOK_TIMEOUT_MS=10000
# Seconds an undelivered event keeps retrying before it is dead-lettered (3 days).
OUTBOX_MAX_AGE=259200
# How many dead-lettered events to keep (oldest dropped beyond this).
OUTBOX_DEAD_MAX=1000
# GET /ready answers 503 once weir is more than this many blocks behind the node
# (chainLag = node height - weir tip height; 1 is normal for a moment after every block).
READY_MAX_LAG=2

# Consumed by docker-compose for the redis container.
# See docs: watch capacity ~= (mem / 1.5 - 45mb) / 330 bytes
REDIS_MAXMEMORY=256mb
